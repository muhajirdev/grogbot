NODE_ENV=development
DATABASE_URL=postgres://grogbot:grogbot@127.0.0.1:5433/grogbot
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
# Production API: WEB_ORIGIN=https://app.grogbot.com
#                 BETTER_AUTH_URL=https://api.grogbot.com
# Marketing site (TanStack Start): https://grogbot.com
# Packaged desktop loads https://app.grogbot.com unless WEB_ORIGIN is set.
CORS_ORIGINS=
# Google OAuth Web client. Redirect: http://127.0.0.1:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth App. Callback: http://127.0.0.1:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Magic-link email via Cloudflare Email Sending REST (the API is Node, not a
# Worker — do not add wrangler.toml; send_email bindings only work on Workers).
# Enable sending for your domain, then a token with Email Sending permission:
# https://developers.cloudflare.com/email-service/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM=Grogbot <noreply@yourdomain.com>
WORKER_URL=http://127.0.0.1:3101
WORKER_PORT=3101
# Guest agents (Hermes/OpenClaw) dial the worker. Override if the guest should
# hit a different origin. Leave unset to use WORKER_URL, or the API when the
# worker is in-process.
GUEST_URL=
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
SANDBOX_PROVIDER=fake
# Default harness is Flue + Pi. Tests/CI force AGENT_RUNTIME=scripted.
# Optional process defaults. The office Settings → Models tab stores
# workspace keys (encrypted) instead of requiring these in .env.
AGENT_RUNTIME=flue
GROGBOT_MODEL=anthropic/claude-sonnet-4-6
# Offline Flue (no keys): AGENT_RUNTIME=flue-echo
# Single-shot chat completions (no Pi loop): AGENT_RUNTIME=gateway
# AI_GATEWAY_PROVIDER=cloudflare
# AI_GATEWAY_MODEL=@cf/deepseek-ai/deepseek-v4-flash-0731
# CLOUDFLARE_ACCOUNT_ID is shared with magic-link email above.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=default
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COMPOSIO_API_KEY=
E2B_API_KEY=
LOG_LEVEL=info
