NODE_ENV=development
DATABASE_URL=postgres://grogbot:grogbot@127.0.0.1:5433/grogbot
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
# Production API: WEB_ORIGIN=https://app.grogbot.com
#                 BETTER_AUTH_URL=https://api.grogbot.com
# Marketing site (TanStack Start): https://grogbot.com
# Packaged desktop loads https://app.grogbot.com unless WEB_ORIGIN is set.
CORS_ORIGINS=
# Google OAuth Web client. Redirect: http://127.0.0.1:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth App. Callback: http://127.0.0.1:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WORKER_URL=http://127.0.0.1:3101
WORKER_PORT=3101
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
SANDBOX_PROVIDER=fake
AGENT_RUNTIME=scripted
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COMPOSIO_API_KEY=
E2B_API_KEY=
LOG_LEVEL=info
