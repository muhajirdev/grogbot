{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grogbot-web",
  // Office SPA at app.grogbot.com. Attach the custom domain in the Cloudflare
  // dashboard — do not put account IDs or secrets here.
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
